# WebDrop Pro - Environment Variables Reference
#
# This file documents ALL environment variables used by the project.
# Copy the relevant ones to:
#   - Cloudflare Pages → Settings → Environment variables (for production)
#   - .dev.vars (for local development with `wrangler pages dev`)

# === SECRETS (encrypted in Cloudflare, never in frontend) ===

# Neon PostgreSQL pooled connection string.
# Get this from: Neon Console → your project → Connection Details → Pooled connection
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Metered TURN credentials (static TURN username + password for your app).
# Get these from: Metered dashboard → your app → TURN section
TURN_USERNAME=your_turn_username
TURN_PASSWORD=your_turn_password

# === PLAIN TEXT (safe to expose, not secret) ===

# Your site's public URL (used to construct invitation links in QR codes)
PUBLIC_BASE_URL=https://webdrop-pro.pages.dev

# TURN provider identifier (controls which TURN servers are configured)
# Options: metered-static, openrelay-static
TURN_PROVIDER=metered-static

# === LOCAL DEVELOPMENT ONLY ===

# For local dev, copy .dev.vars.example to .dev.vars and fill in real values.
# .dev.vars is gitignored and never committed.

# === NOT NEEDED (saved for future upgrade) ===

# If you upgrade to Metered's ephemeral credential API later, you'll need:
# TURN_API_KEY=sk_id_xxxxx
# TURN_API_SECRET=sk_secret_xxxxx
# TURN_APP_ID=your-metered-app-id-uuid
# TURN_CREDENTIAL_TTL=3600
#
# These are NOT needed for the current static-credential implementation.
